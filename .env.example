# ==========================================================================
# Variables de entorno de backend_clinica (Clínica DS)
# Copia este archivo como .env (local) o configúralas en Render (producción).
# NO pongas valores reales en este archivo: es solo una plantilla.
# ==========================================================================

# --- Django ---
# Clave secreta de Django. OBLIGATORIA. Genera una nueva, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# DEBUG: "True" solo en desarrollo. En producción dejar en "False".
DEBUG=False

# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,nubnest.com,www.nubnest.com,app.nubnest.com

# Orígenes confiables para CSRF (solo se usan cuando DEBUG=False), separados por comas.
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://nubnest.com,https://www.nubnest.com,https://app.nubnest.com

# --- Base de datos ---
# URL de conexión. En producción (Render) usar PostgreSQL, p. ej.:
#   postgres://USUARIO:PASSWORD@HOST:5432/NOMBRE_BD
# En local puedes usar SQLite:
#   sqlite:///db.sqlite3
DATABASE_URL=

# --- Correo (Resend vía django-anymail) ---
# API key de Resend. OBLIGATORIA para enviar correos.
RESEND_API_KEY=
# Remitente por defecto de los correos.
DEFAULT_FROM_EMAIL=onboarding@resend.dev
